# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram numeric IDs with admin access
ADMIN_IDS=

# Injected automatically by Heroku Postgres. Locally: postgres://user:pass@host:5432/db
DATABASE_URL=

# Optional: remote proxy list (one URL per line, scheme://user:pass@host:port)
PROXY_LIST_URL=

# Tuning
CHECK_CONCURRENCY=10
CHECK_TIMEOUT=30
DEFAULT_CREDITS=10
HIT_RETENTION_DAYS=30
LOG_LEVEL=INFO
