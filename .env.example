# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Your Telegram numeric ID for admin commands (optional)
ADMIN_IDS=

# Comma-separated Telegram numeric IDs to silently ignore (optional)
BANNED_IDS=

# Optional Postgres URL so per-user proxy lists survive restarts.
# Neon / Supabase free tier works. Blank = in-memory only.
DATABASE_URL=

# Shared proxy pool everyone falls back to (optional)
PROXY_LIST_URL=
PROXY_LIST=

# Tuning
CHECK_CONCURRENCY=20
CHECK_TIMEOUT=30
MAX_COOKIES_PER_JOB=0
JOB_COOLDOWN_SECONDS=10
PROXY_REFRESH_MINUTES=10
MAX_PROXIES_PER_USER=500
LOG_LEVEL=info

# Inbox search
MAX_SEARCH_ACCOUNTS=20
SEARCH_RESULTS_LIMIT=25
MAX_SEARCH_TERM_LENGTH=120
