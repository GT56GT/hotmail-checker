# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Comma-separated Telegram numeric IDs with admin access (optional)
ADMIN_IDS=

# Comma-separated Telegram numeric IDs to silently ignore (optional)
BANNED_IDS=

# Remote proxy list, one per line: scheme://user:pass@host:port (optional)
PROXY_LIST_URL=

# Inline proxy list, newline or comma separated (optional)
PROXY_LIST=

# Tuning
CHECK_CONCURRENCY=20
CHECK_TIMEOUT=30
MAX_COOKIES_PER_JOB=2000
JOB_COOLDOWN_SECONDS=30
PROXY_REFRESH_MINUTES=10
LOG_LEVEL=info

# Inbox search
MAX_SEARCH_ACCOUNTS=20
SEARCH_RESULTS_LIMIT=25
MAX_SEARCH_TERM_LENGTH=120
