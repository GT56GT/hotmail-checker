{
  "name": "hotmail-checker",
  "description": "Hotmail cookie validator with inbox search - Telegram bot",
  "repository": "https://github.com/GT56GT/hotmail-checker",
  "keywords": ["telegram", "bot", "checker", "go", "tls", "mail-search"],
  "stack": "heroku-24",
  "buildpacks": [
    { "url": "heroku/go" }
  ],
  "formation": {
    "worker": { "quantity": 1, "size": "eco" },
    "web": { "quantity": 0 }
  },
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram bot token from @BotFather",
      "required": true
    },
    "ADMIN_IDS": {
      "description": "Comma-separated Telegram numeric IDs with admin access",
      "required": false
    },
    "PROXY_LIST_URL": {
      "description": "Remote proxy list URL, one proxy per line",
      "required": false
    },
    "CHECK_CONCURRENCY": {
      "description": "Concurrent checks per worker",
      "value": "20",
      "required": false
    },
    "MAX_COOKIES_PER_JOB": {
      "description": "Maximum accounts accepted per upload",
      "value": "2000",
      "required": false
    },
    "MAX_SEARCH_ACCOUNTS": {
      "description": "Live accounts searched per job",
      "value": "20",
      "required": false
    },
    "SEARCH_RESULTS_LIMIT": {
      "description": "Messages returned per searched account",
      "value": "25",
      "required": false
    },
    "LOG_LEVEL": {
      "description": "debug | info | warn | error",
      "value": "info",
      "required": false
    }
  }
}
